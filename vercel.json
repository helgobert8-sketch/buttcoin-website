{
  "redirects": [
    { "source": "/legend", "destination": "https://x.com/ButtcoinBitcoin/status/2078593825832911030", "permanent": false },
    { "source": "/2013", "destination": "https://www.youtube.com/watch?v=uh-zxexGSA4", "permanent": false }
  ],
  "rewrites": [
    { "source": "/for-ai", "destination": "/for-ai.html" },
    { "source": "/game", "destination": "/game.html" },
    { "source": "/church", "destination": "/church.html" },
    { "source": "/crossing", "destination": "/crossing.html" },
